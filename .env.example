# Garmin Connect Personal API key (official, read-only). Create it at
# https://connect.garmin.com/app/settings/personalApiToken -- it is shown once
# and lasts 30 days to a year. Carries activities, sleep, daily wellness, HRV
# and weight with no password. Copy this file to .env (gitignored).
GARMIN_PERSONAL_API_KEY=

# Optional. Only for the legacy session (garmin_sync.py --login), which still
# supplies readiness, training status, VO2max/heat, endurance score and laps.
# Its tokens are cached in ~/.garminconnect, so these are not required.
GARMIN_EMAIL=
GARMIN_PASSWORD=
